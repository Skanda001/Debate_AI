# ==============================================================================
# DEBATE AI / LLM Arena - Backend Environment Configuration
# ==============================================================================

# Django Secret Key (generate a strong key for production)
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production

# Debug Mode (set to False in production)
DEBUG=True

# Database URL (optional, defaults to SQLite if omitted)
# DATABASE_URL=postgres://user:password@localhost:5432/debate_ai

# Frontend URL for CORS (comma-separated or single URL)
FRONTEND_ORIGIN=http://localhost:5173

# ==============================================================================
# Contestant LLM Configuration
# Format: Comma-separated list of provider:model_name
# Supported providers: ollama, gemini, openai, groq, openrouter, cerebras, mistral
# ==============================================================================
CONTESTANTS=groq:openai/gpt-oss-120b,gemini:gemini-2.5-flash,ollama:llama3.2:1b

# ==============================================================================
# Independent Judge Model Configuration
# Note: Keep the judge separate from contestants for unbiased scoring.
# ==============================================================================
JUDGE_MODEL=gemini:gemini-2.5-flash

# ==============================================================================
# API Keys & Endpoints (configure only the providers you use)
# ==============================================================================

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cerebras Cloud
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Local Ollama (default is http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
